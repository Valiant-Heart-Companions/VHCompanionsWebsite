---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="How It Works"
  description="Learn about the Valiant Heart Companions process — from application through placement and ongoing support. See how we match survivors with the perfect service dog partner."
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- Page hero -->
  <section
    class="relative py-24 text-white text-center"
    style="background: linear-gradient(135deg, #2a4f3b 0%, #3b6e52 100%);"
  >
    <div class="section-container relative z-10">
      <div class="badge badge-accent badge-outline mb-6">The Process</div>
      <h1 class="font-heading text-5xl md:text-6xl font-bold mb-4 text-white">
        From Application<br class="hidden sm:block" />to Life-Changing Partnership
      </h1>
      <p class="text-white/80 text-xl max-w-2xl mx-auto">
        Our carefully designed process ensures every dog and every survivor
        are the right match — and that the partnership lasts a lifetime.
      </p>
    </div>
  </section>

  <!-- Timeline steps -->
  <section class="py-20 bg-white">
    <div class="section-container max-w-4xl">
      <h2 class="section-heading heading-accent text-center mx-auto mb-14">Our 5-Step Journey</h2>

      <div class="space-y-12">
        {[
          {
            step: '01',
            title: 'Application & Intake',
            duration: 'Weeks 1–2',
            color: 'bg-primary',
            desc: "Submit your application online. Our intake team — led by a licensed trauma therapist — reviews your needs, trauma history (at a level you're comfortable sharing), and lifestyle to begin understanding the right dog for you.",
            detail: 'We accept applications from survivors of all genders. There is no waitlist fee, and our services are provided at little to no cost to qualified applicants.',
          },
          {
            step: '02',
            title: 'Assessment & Matching',
            duration: 'Weeks 2–6',
            color: 'bg-secondary',
            desc: 'A certified service dog trainer and our clinical team collaborate to identify which dog from our training program is the best behavioral and temperamental match for you.',
            detail: 'We assess your daily routines, living situation, support network, and the specific PTSD symptoms you most need help managing — then match accordingly.',
          },
          {
            step: '03',
            title: 'Dog Training',
            duration: 'Months 2–20',
            color: 'bg-accent',
            desc: 'Your matched dog undergoes specialized task training tailored to your needs. This includes the core public access skills all service dogs need, plus 8–15 custom tasks.',
            detail: 'Typical tasks include: nightmare interruption, deep pressure therapy, room clearing, crowd buffering, alerting to approaches, medication reminders, and grounding during flashbacks.',
          },
          {
            step: '04',
            title: 'Team Training',
            duration: 'Weeks 18–22',
            color: 'bg-primary',
            desc: 'You and your dog train together — first virtually, then in person over a two-week intensive placement period. This phase builds your bond and teaches you how to work as a team.',
            detail: 'By the end of team training, you and your dog will have practiced skills in real public environments: grocery stores, public transit, crowded venues, and more.',
          },
          {
            step: '05',
            title: 'Placement & Ongoing Support',
            duration: 'Lifelong',
            color: 'bg-secondary',
            desc: 'Your dog comes home with you. Our work doesn\'t stop at placement — we provide monthly check-ins for the first year, an annual in-person visit, refresher training as needed, and access to our recipient community.',
            detail: 'We remain a resource for the full life of your partnership — including guidance if your needs change, support through major life transitions, and connection to our growing community of recipients.',
          },
        ].map(({ step, title, duration, color, desc, detail }) => (
          <div class="flex gap-6 md:gap-10">
            <div class="flex flex-col items-center">
              <div class={`w-14 h-14 rounded-full ${color} text-white flex items-center justify-center font-heading font-bold text-lg flex-shrink-0 shadow-md`}>
                {step}
              </div>
              <div class="w-0.5 bg-linen-200 flex-1 mt-3"></div>
            </div>
            <div class="pb-10 flex-1">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <h3 class="font-heading font-bold text-2xl text-neutral">{title}</h3>
                <span class="badge badge-outline badge-sm text-xs font-semibold">{duration}</span>
              </div>
              <p class="text-neutral/75 leading-relaxed mb-3">{desc}</p>
              <p class="text-neutral/60 text-sm leading-relaxed bg-linen rounded-xl px-4 py-3 border border-linen-200">{detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-linen">
    <div class="section-container max-w-3xl">
      <h2 class="section-heading heading-accent text-center mx-auto mb-10">Frequently Asked Questions</h2>

      <div class="space-y-4">
        {[
          {
            q: 'Is there a cost to receive a service dog?',
            a: 'We provide service dogs at little to no cost to qualified applicants. There is no application fee. We ask recipients to contribute what they are able, but we will never turn away a qualified survivor due to inability to pay. Our donors make this possible.',
          },
          {
            q: 'Who qualifies for our program?',
            a: 'We serve adult survivors (18+) of sexual assault who have been diagnosed with or show symptoms consistent with PTSD, anxiety, or related trauma responses. We welcome applicants of all genders, backgrounds, and locations within the US.',
          },
          {
            q: 'How long is the waitlist?',
            a: 'Current wait times range from 12–24 months from application to placement, depending on match availability. We work to minimize this as our training capacity grows — your donations directly fund additional dogs in training.',
          },
          {
            q: 'What breeds do you use?',
            a: 'We primarily work with Labrador Retrievers, Golden Retrievers, and Standard Poodles — breeds with the temperament, trainability, and physical capabilities needed for psychiatric service dog work. We occasionally work with other breeds on a case-by-case basis.',
          },
          {
            q: 'What if the placement doesn\'t work out?',
            a: 'In the rare event that a placement isn\'t the right fit, we will work to either resolve the issue through additional training and support, or — if necessary — rematch you with another dog at no cost. Your success and the dog\'s wellbeing are both our priority.',
          },
          {
            q: 'Can I apply if I live outside Florida?',
            a: 'Yes. We serve survivors across all 50 states. The in-person team training period typically takes place at our facility in Lakeland, FL, with travel and accommodation assistance available for those who need it.',
          },
        ].map(({ q, a }) => (
          <details class="card-warm group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-neutral hover:text-primary transition-colors">
              <span>{q}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-180 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 text-neutral/70 leading-relaxed text-sm">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Apply CTA -->
  <section class="py-16 bg-secondary text-white text-center">
    <div class="section-container max-w-xl">
      <h2 class="font-heading text-3xl font-bold text-white mb-3">Ready to Apply?</h2>
      <p class="text-white/75 mb-8">The application takes about 20 minutes and is completely free. Our team reviews every application personally.</p>
      <a href="/apply" class="btn btn-accent rounded-full px-10 text-base shadow-lg">
        Start Your Application →
      </a>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
