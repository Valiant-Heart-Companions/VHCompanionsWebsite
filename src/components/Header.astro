---
const navLinks = [
  { href: '/',             label: 'Home' },
  { href: '/about',        label: 'About' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/dogs',         label: 'Our Dogs' },
  { href: '/stories',      label: 'Stories' },
  { href: '/blog',         label: 'Blog' },
  { href: '/volunteer',    label: 'Volunteer' },
  { href: '/contact',      label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-primary text-white">
  <!-- Top bar -->
  <div class="section-container py-4 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" aria-label="Valiant Heart Companions home">
      <div class="w-12 h-12 flex-shrink-0" aria-hidden="true">
        <svg viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-sm">
          <path d="M28 48 C28 48 6 34 6 20 C6 13 11 8 17 8 C21 8 25 10 28 14 C31 10 35 8 39 8 C45 8 50 13 50 20 C50 34 28 48 28 48Z" fill="#e8a07a"/>
          <path d="M28 46 C28 46 8 33 8 20 C8 14 12.5 9.5 17.5 9.5 C21 9.5 24.5 11.5 27 15 C29.5 11.5 33 9.5 38.5 9.5 C43.5 9.5 48 14 48 20 C48 33 28 46 28 46Z" fill="#a83c54"/>
          <ellipse cx="28" cy="34" rx="5.5" ry="4.5" fill="white" opacity="0.92"/>
          <ellipse cx="20.5" cy="27.5" rx="2.8" ry="2.3" fill="white" opacity="0.92"/>
          <ellipse cx="28" cy="24.5" rx="2.8" ry="2.3" fill="white" opacity="0.92"/>
          <ellipse cx="35.5" cy="27.5" rx="2.8" ry="2.3" fill="white" opacity="0.92"/>
        </svg>
      </div>
      <div>
        <div class="font-heading font-bold text-xl leading-tight group-hover:text-white/90 transition-colors">
          Valiant Heart Companions
        </div>
        <div class="text-white/75 text-xs tracking-wide">Training service dogs for survivors</div>
      </div>
    </a>

    <!-- Desktop donate CTA -->
    <a href="/donate" class="hidden md:inline-flex btn btn-accent btn-sm rounded-full font-semibold gap-1.5 shadow-md hover:shadow-lg transition-shadow">
      <span aria-hidden="true">♥</span> Donate Now
    </a>
  </div>
</header>

<!-- Sticky nav -->
<nav class="bg-primary/95 backdrop-blur-sm sticky top-0 z-50 shadow-md" aria-label="Main navigation">
  <div class="section-container flex items-center justify-between py-0">
    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden text-white p-3 -ml-3 hover:bg-white/10 rounded-lg transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Nav links -->
    <ul
      id="nav-links"
      class="hidden md:flex items-center gap-0.5 flex-wrap"
    >
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-4 text-sm font-semibold text-white/90 hover:text-white hover:bg-white/10 rounded transition-colors',
                { 'text-white bg-white/15': isActive }
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Mobile donate -->
    <a href="/donate" class="md:hidden btn btn-accent btn-xs rounded-full font-semibold">
      ♥ Donate
    </a>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/20 bg-primary/98">
    <ul class="section-container py-2 flex flex-col gap-0.5">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2.5 text-sm font-semibold text-white/90 hover:text-white hover:bg-white/10 rounded transition-colors',
                { 'text-white bg-white/15': isActive }
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
      <li class="pt-2 pb-1">
        <a href="/donate" class="btn btn-accent btn-sm w-full rounded-full">♥ Donate Now</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconMenu?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
