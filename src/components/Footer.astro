---
const year = new Date().getFullYear();
---

<!-- Mobile floating donate FAB -->
<a
  href="/donate"
  class="md:hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 btn btn-accent rounded-full shadow-xl shadow-accent/30 px-6 font-semibold"
  aria-label="Donate now"
>
  ♥ Donate Now
</a>

<!-- Wave transition -->
<div class="bg-linen overflow-hidden leading-none mt-16">
  <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" class="block w-full" aria-hidden="true" preserveAspectRatio="none">
    <path fill="#2a4f3b" d="M0,32L60,28C120,24,240,16,360,16C480,16,600,24,720,26.7C840,29,960,27,1080,22.7C1200,19,1320,13,1380,10.7L1440,8L1440,48L0,48Z"/>
  </svg>
</div>

<footer class="bg-[#2a4f3b] text-white">
  <div class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-4 group" aria-label="Valiant Heart Companions home">
          <svg viewBox="0 0 56 56" class="w-10 h-10 flex-shrink-0" aria-hidden="true">
            <path d="M28 48 C28 48 6 34 6 20 C6 13 11 8 17 8 C21 8 25 10 28 14 C31 10 35 8 39 8 C45 8 50 13 50 20 C50 34 28 48 28 48Z" fill="rgba(255,255,255,0.2)"/>
            <path d="M28 46 C28 46 8 33 8 20 C8 14 12.5 9.5 17.5 9.5 C21 9.5 24.5 11.5 27 15 C29.5 11.5 33 9.5 38.5 9.5 C43.5 9.5 48 14 48 20 C48 33 28 46 28 46Z" fill="rgba(255,255,255,0.9)"/>
            <ellipse cx="28" cy="34" rx="5.5" ry="4.5" fill="#2a4f3b"/>
            <ellipse cx="20.5" cy="27.5" rx="2.8" ry="2.3" fill="#2a4f3b"/>
            <ellipse cx="28" cy="24.5" rx="2.8" ry="2.3" fill="#2a4f3b"/>
            <ellipse cx="35.5" cy="27.5" rx="2.8" ry="2.3" fill="#2a4f3b"/>
          </svg>
          <div>
            <div class="font-heading font-bold text-lg leading-tight">Valiant Heart Companions</div>
            <div class="text-white/60 text-xs">Training service dogs for survivors</div>
          </div>
        </a>
        <p class="text-white/70 text-sm leading-relaxed max-w-sm">
          A 501(c)(3) nonprofit organization dedicated to training specialized service dogs
          for survivors of sexual assault — providing healing, independence, and renewed peace.
        </p>
        <p class="text-white/50 text-xs mt-3">EIN: 82-4410052 · Donations are tax-deductible</p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-heading font-semibold text-white mb-4 text-sm uppercase tracking-wider">Quick Links</h3>
        <ul class="space-y-2">
          {[
            ['/', 'Home'],
            ['/about', 'About Us'],
            ['/how-it-works', 'How It Works'],
            ['/apply', 'Apply for a Dog'],
            ['/dogs', 'Our Dogs'],
            ['/stories', 'Survivor Stories'],
            ['/blog', 'Blog & Resources'],
            ['/volunteer', 'Volunteer'],
            ['/donate', 'Donate'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="text-white/70 hover:text-white text-sm transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & trust -->
      <div>
        <h3 class="font-heading font-semibold text-white mb-4 text-sm uppercase tracking-wider">Contact</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="mailto:info@vhcompanions.org" class="hover:text-white transition-colors">info@vhcompanions.org</a></li>
          <li><a href="mailto:applications@vhcompanions.org" class="hover:text-white transition-colors">applications@vhcompanions.org</a></li>
          <li><a href="mailto:development@vhcompanions.org" class="hover:text-white transition-colors">development@vhcompanions.org</a></li>
          <li class="pt-1">1635 West Daughtery Road<br>Lakeland, FL 33810</li>
        </ul>

        <a href="/donate" class="btn btn-accent btn-sm rounded-full mt-6 shadow-md hover:shadow-lg transition-shadow">
          ♥ Make a Gift
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="section-container py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/50">
      <p>© {year} Valiant Heart Companions. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-white/80 transition-colors">Privacy Policy</a>
        <a href="/contact" class="hover:text-white/80 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>

<!-- Back to top -->
<button
  id="back-to-top"
  class="fixed bottom-20 right-5 md:bottom-6 w-10 h-10 bg-primary text-white rounded-full shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-primary/80 z-40"
  aria-label="Back to top"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      btn?.classList.remove('opacity-0', 'pointer-events-none');
      btn?.classList.add('opacity-100');
    } else {
      btn?.classList.add('opacity-0', 'pointer-events-none');
      btn?.classList.remove('opacity-100');
    }
  });
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
