---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Valiant Heart Companions trains specialized service dogs for survivors of sexual assault, helping them reclaim independence, safety, and peace. 501(c)(3) nonprofit — EIN 82-4410052.',
  image = 'https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=1200&q=80',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Home'
  ? 'Valiant Heart Companions — Service Dogs for Survivors'
  : `${title} — Valiant Heart Companions`;
---

<!doctype html>
<html lang="en" data-theme="vhc">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Valiant Heart Companions" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body class="min-h-screen flex flex-col">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-accent-content focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold">
    Skip to main content
  </a>

  <slot name="header" />

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <slot name="footer" />

</body>
</html>
